# Traveling Peddler web export — environment for the WORLD and GATEWAY services.
#
# INSTALL THIS AS  /etc/arkenelle/peddler.env  ON THE VPS. Not in /opt/arkenelle:
# that is the git checkout, update.sh reinstalls over it, and a secret sitting in
# a working tree is a secret one `git add -A` away from being public forever.
#
#   sudo install -d -m 0750 -o root -g arkenelle /etc/arkenelle
#   sudo install -m 0640 -o root -g arkenelle \
#        /opt/arkenelle/deploy/config/peddler.env.example /etc/arkenelle/peddler.env
#   sudo nano /etc/arkenelle/peddler.env      # paste the generated key
#
# 0640 root:arkenelle — the service user reads it, nobody else on the box can.
#
# Both units load it with `EnvironmentFile=-` (the dash makes it OPTIONAL), so a
# missing file leaves the exporter silent instead of refusing to start the world.
# That is deliberate: a website widget must never be able to keep the game down.
#
# systemd parses this file itself — it is NOT a shell script. No `export`, no
# command substitution, no quotes unless you mean them to be part of the value.

# Where the world server POSTs its snapshot.
#
# LOOPBACK, not https://api.arkenelle.com/... . The world and the gateway are on
# the same box, so going out through Caddy would add a TLS handshake and a public
# round trip to an internal call — and it would mean the write endpoint has to be
# reachable from the internet. It is not: the Caddyfile refuses this path
# publicly, so the only thing that can reach it is something already on the host.
ARKENELLE_PEDDLER_WEBHOOK_URL=http://127.0.0.1:8088/v1/peddler/update

# Shared server-to-server secret. The world sends it as `Authorization: Bearer`,
# the gateway compares it against this same value. BOTH services read this one
# file, so there is a single place for the key and no way for the two halves to
# drift out of sync.
#
# GENERATE YOUR OWN — do not ship this placeholder:
#
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 48; echo
#
# Rotating it is safe at any time: set the new value, restart both services, and
# the next spawn/despawn/roll re-sends the whole snapshot. There is no state to
# migrate and at worst the tracker is one cycle stale.
ARKENELLE_PEDDLER_WEBHOOK_KEY=REPLACE_ME_WITH_A_GENERATED_KEY


# ---------------------------------------------------------------------------
# Discord announcement (OPTIONAL — leave both blank to turn it off entirely)
# ---------------------------------------------------------------------------
# Posts once when the Peddler SPAWNS. Not on despawn, not on the midnight stock
# roll: those are notifications nobody can act on, and a channel that pings six
# times a day for them is a channel people mute -- taking the one message that
# mattered with it.
#
# The webhook URL IS a credential. Anyone who has it can post into that channel
# as the bot, so it is treated exactly like the key above: environment only,
# never committed, never printed to a log. If it ever leaks, delete the webhook
# in Discord and make a new one -- that instantly invalidates the old URL.
#
# Discord -> your server -> Edit Channel -> Integrations -> Webhooks -> New
ARKENELLE_PEDDLER_DISCORD_WEBHOOK=

# OPTIONAL opt-in role to ping, as its numeric id (NOT the role name).
# Leave blank for a silent announcement that pings nobody.
#
# To get the id: Discord Settings -> Advanced -> Developer Mode ON, then
# right-click the role -> Copy Role ID. It is a long number like 1234567890123456789.
#
# Make the role self-assignable so the ping is opt-in; @everyone is deliberately
# not supported here. The message also carries an allowed_mentions whitelist, so
# this role is the ONLY thing it can ping even if an item name contained an @.
ARKENELLE_PEDDLER_DISCORD_ROLE_ID=
