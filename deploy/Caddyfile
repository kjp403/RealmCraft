# Arkenelle reverse proxy — public HTTPS (Caddy auto-provisions Let's Encrypt
# certs for both hostnames, so you don't manage certificates yourself).
#
# api.arkenelle.com  -> gateway HTTP API (login/accounts/world list) on 127.0.0.1:8088
# play.arkenelle.com -> browser client (static Godot web export) + world WebSocket
#                      on 127.0.0.1:8087. GET / serves /opt/arkenelle/client-web;
#                      GET /desktop/ serves the Windows zip + latest.json;
#                      Upgrade: websocket still goes to the world. Leave this
#                      hostname DNS-only (grey cloud) in Cloudflare.
#
# The game servers stay bound to loopback (127.0.0.1); Caddy is the only thing
# exposed to the internet. Copy this to /etc/caddy/Caddyfile on the VPS.

api.arkenelle.com {
	# The Peddler WRITE endpoint is server-to-server only: the world server posts
	# to it over loopback, so nothing on the internet has any business reaching
	# it. Blocked here as well as bearer-checked in the gateway — the auth is the
	# guarantee, this just removes the attack surface entirely.
	# GET /v1/peddler (the public read the website polls) is untouched.
	@peddler_write path /v1/peddler/update
	respond @peddler_write 404

	# Same reasoning, and it matters more here because these move money. The
	# world server calls them over loopback; nothing on the internet has any
	# business reaching a balance read, a debit or a grant. Bearer-checked in the gateway
	# as well — that check is the guarantee, this removes the attack surface.
	#
	# LISTED EXPLICITLY, NOT /v1/premium/* — the Stripe webhook lives under that
	# same prefix and MUST stay publicly reachable, because Stripe calls it from
	# their servers. A wildcard here silently 404s every payment notification and
	# the symptom is players paying and never being credited. Adding a premium
	# route means deciding, here, whether it is internal or public.
	# /v1/premium/grant is on this list for the same reason: it ADDS currency on
	# staff authority (the /arkcoins command), so it is the single most valuable
	# route on the box to anyone who finds it.
	@premium_internal path /v1/premium/balance /v1/premium/purchase /v1/premium/grant
	respond @premium_internal 404

	# PUBLIC on purpose, unlike the three above: the storefront on
	# arkenelle.com asks whether an account name exists before it will build
	# a Stripe link, which is what stops a character name typed in that box from
	# becoming a payment nobody can credit. It answers one bool and is rate
	# limited in the gateway. Blocking it here silently returns the site to
	# accepting any name at all.

	# The gateway rate-limiter reads the real client IP from this header
	# (see source/server/gateway/http_server.gd).
	reverse_proxy 127.0.0.1:8088 {
		header_up X-Real-IP {remote_host}
	}
}

play.arkenelle.com {
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}

	handle @websocket {
		reverse_proxy 127.0.0.1:8087
	}

	handle_path /desktop/* {
		root * /opt/arkenelle/client-windows
		@zip path *.zip
		header @zip Content-Type application/octet-stream
		header @zip Content-Disposition "attachment; filename=\"Arkenelle-windows.zip\""
		file_server
	}

	handle {
		root * /opt/arkenelle/client-web
		encode gzip
		@pck path *.pck
		header @pck Content-Type application/octet-stream
		@nocache path *.pck *.wasm *.js
		header @nocache Cache-Control "no-cache"
		file_server
	}
}
