; A plain Panel, NOT a PanelContainer. A PanelContainer force-fits EVERY child
; to its one content rect and throws the children's own anchors away, which
; stacked the name, the HP number and the chill meter on the same line — three
; centred labels printing through each other. A Panel draws the backing and
; leaves the layout to the rows below.
[node name="Panel" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("SB_backing")

[node name="NameLabel" type="Label" parent="Panel"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 12.0
offset_top = 6.0
