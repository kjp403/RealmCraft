[sub_resource type="Resource" id="Node_crush"]
script = ExtResource("2_node")
id = &"hammer_crush"
tier = 1
description = "CRUSHING BLOW, rank 1 of 4. A heavy slam that hits everything around you. Each later rank REPLACES this one and hits harder — Shockwave, then Earthshatter, then Cataclysm."
branch = &"domination"
ability = ExtResource("4_crush")

[sub_resource type="Resource" id="Node_shock"]
script = ExtResource("2_node")
id = &"hammer_shockwave"
description = "CRUSHING BLOW, rank 2 of 4. The same slam, driven through the ground: more damage than rank 1, and everyone caught is slowed."
branch = &"domination"
tier = 2
ability = ExtResource("5_shock")
upgrades = &"hammer_crush"

[sub_resource type="Resource" id="Node_quake"]
script = ExtResource("2_node")
id = &"hammer_earthshatter"
description = "CRUSHING BLOW, rank 3 of 4. A devastating quake with real reach. It winds up before it lands, so commit early."
branch = &"domination"
tier = 3
ability = ExtResource("6_quake")
upgrades = &"hammer_shockwave"

[sub_resource type="Resource" id="Node_cataclysm"]
script = ExtResource("2_node")
id = &"hammer_cataclysm"
description = "CRUSHING BLOW, rank 4 of 4. The hammer's apocalypse: a slow, earth-rending blow that devastates and badly slows everything around you."
branch = &"domination"
tier = 4
ability = ExtResource("11_cata")
upgrades = &"hammer_earthshatter"

