[sub_resource type="Resource" id="Node_after1"]
script = ExtResource("2_node")
id = &"hammer_aftershock"
tier = 2
description = "AFTERSHOCK, rank 1 of 3. Plant and detonate: a shockwave that slams everyone around you, scales with your MAX HEALTH as well as your damage, and heals you for every enemy it catches. The tank's rotation filler."
branch = &"domination"
ability = ExtResource("18_after1")

[sub_resource type="Resource" id="Node_after2"]
script = ExtResource("2_node")
id = &"hammer_aftershock_2"
description = "AFTERSHOCK, rank 2 of 3. Wider, harder, and it claws back more health per enemy hit."
branch = &"domination"
tier = 3
ability = ExtResource("19_after2")
upgrades = &"hammer_aftershock"

[sub_resource type="Resource" id="Node_after3"]
script = ExtResource("2_node")
id = &"hammer_aftershock_3"
description = "AFTERSHOCK, rank 3 of 3. The strongest shockwave: biggest reach, hardest hit, heaviest self-heal, and it slows everyone caught in it."
branch = &"domination"
tier = 4
ability = ExtResource("20_after3")
upgrades = &"hammer_aftershock_2"

[sub_resource type="Resource" id="Node_ward1"]
script = ExtResource("2_node")
id = &"hammer_spectral_ward"
tier = 1
description = "SPECTRAL WARD, rank 1 of 3. Summon spectral shields that orbit you, cut a flat share off every hit you take, and throw everything they block straight back at whoever swung. Flat mitigation, so it scales WITH the boss instead of against it."
branch = &"resolve"
ability = ExtResource("21_ward1")

[sub_resource type="Resource" id="Node_ward2"]
script = ExtResource("2_node")
id = &"hammer_spectral_ward_2"
description = "SPECTRAL WARD, rank 2 of 3. A second shield joins the orbit: a deeper cut, more damage thrown back, held longer, with armor on top."
branch = &"resolve"
tier = 2
ability = ExtResource("22_ward2")
upgrades = &"hammer_spectral_ward"

[sub_resource type="Resource" id="Node_ward3"]
script = ExtResource("2_node")
id = &"hammer_spectral_ward_3"
description = "SPECTRAL WARD, rank 3 of 3. Three shields, most of the damage turned aside and hurled back, and resistance to spellwork. Roar first, then ward: the phase that was supposed to kill you becomes your biggest damage window."
branch = &"resolve"
tier = 3
ability = ExtResource("23_ward3")
upgrades = &"hammer_spectral_ward_2"

[sub_resource type="Resource" id="Node_roar1"]
script = ExtResource("2_node")
id = &"hammer_roar"
tier = 1
description = "MIGHTY ROAR, rank 1 of 3. Shout down everything nearby: they drop whatever they were chasing and come for YOU, and nothing they take from your group can pull them back off. Your job is to be the target."
branch = &"resolve"
ability = ExtResource("24_roar1")

[sub_resource type="Resource" id="Node_roar2"]
script = ExtResource("2_node")
id = &"hammer_roar_2"
description = "MIGHTY ROAR, rank 2 of 3. Louder, wider, and it holds for far longer — long enough to cover a healer who has been caught out."
branch = &"resolve"
tier = 2
ability = ExtResource("25_roar2")
upgrades = &"hammer_roar"

[sub_resource type="Resource" id="Node_roar3"]
script = ExtResource("2_node")
id = &"hammer_roar_3"
description = "MIGHTY ROAR, rank 3 of 3. The roar never lapses: whatever hears it is yours until it dies or you do. Your group can commit everything, from the pull to the kill."
branch = &"resolve"
tier = 3
ability = ExtResource("26_roar3")
upgrades = &"hammer_roar_2"

[sub_resource type="Resource" id="Mod_hp_juggernaut"]
