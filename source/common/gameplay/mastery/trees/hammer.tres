[sub_resource type="Resource" id="Node_might1"]
script = ExtResource("2_node")
id = &"hammer_paladins_might"
tier = 2
description = "PALADIN'S MIGHT, rank 1 of 3. Aim with the cursor and drop a consecrated circle: everyone standing in it, you included, is healed every second. Placed, not channeled — you keep fighting while it works."
