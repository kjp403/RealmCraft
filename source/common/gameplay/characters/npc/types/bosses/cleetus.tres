[resource]
script = ExtResource("4_script")
enemy_type = &"ossuran"
display_name = "Ossuran, Kindled and Cold"
skin = ExtResource("5_skin")
visual_scale = 1.4
is_boss = true
combat_level = 560
max_health = 120000.0
attack_damage = 165.0
attack_cooldown = 1.4
armor = 210.0
mr = 234.0
