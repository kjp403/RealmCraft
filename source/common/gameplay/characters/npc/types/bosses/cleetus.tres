move_speed = 52
distance_to_attack = 34
max_distance_from_spawn = 520
leashes = false
detection_radius = 260
chase_on_area = true
is_lone = true
wander_radius = 0.0
wander_pause_min_s = 1.5
wander_pause_max_s = 4.0
xp_reward = 11000
respawn_delay = 300.0
respawns = true
loot = Array[ExtResource("3_loot")]([SubResource("Drop_gold"), SubResource("Drop_bone"), SubResource("Drop_key"), SubResource("Drop_mat_chest"), SubResource("Drop_l70_w_sword"), SubResource("Drop_l70_w_hammer"), SubResource("Drop_l70_w_wand"), SubResource("Drop_l70_w_tome"), SubResource("Drop_l70_w_bow"), SubResource("Drop_dragon_bones"), SubResource("Drop_ember_ash"), SubResource("Drop_coal_ore"), SubResource("Drop_blue_lobster"), SubResource("Drop_runite_ore"), SubResource("Drop_yew_log"), SubResource("Drop_runite_bar"), SubResource("Drop_ornate_red_chest"), SubResource("Drop_relic_emberfrost"), SubResource("Drop_oathstone")])
combat_skill_xp_override = 16000
; 0.6 -> 0.5 so the VISUAL enrage (BossController: kindled -> cold skin swap,
; speed-up, frost telegraph tint) lands on the exact same health as the Ossuran
; encounter's phase 3 (OssuranArena: the ice sheet, the cold aura, the switch to
; ranged/magic only). Two systems, one threshold. At 0.6 the boss turned to ice
; a tenth of a health bar before the room did, which reads as a bug.
; NOTE: Ossuran is ALSO summonable as a world boss (/worldboss, see
; EventService), and that fight inherits this change — it now enrages slightly
; later. Deliberate, and the smaller of the two evils.
enrage_health_fraction = 0.5
; Phase gates, drawn as permanent notches on the boss health bar so the
; encounter's structure is legible from the first second. UI only — the server
; still owns when a gate fires (BossStateMachine).
hp_thresholds = Array[float]([0.75, 0.5])
