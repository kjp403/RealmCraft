[sub_resource type="Resource" id="QuestInteraction_welcome"]
script = ExtResource("4_quest_interaction")
quests = Array[ExtResource("2_quest")]([ExtResource("3_welcome")])
metadata/_custom_type_script = "uid://dka1daj2vrhn"

[sub_resource type="Resource" id="Dialogue_progression"]
script = ExtResource("5_dialogue")
lines = Array[String](["Your character level measures your overall growth. Quests and defeated enemies award character experience.", "Weapon Mastery and profession levels are separate from your character level. Your Mastery panel tracks weapon disciplines; your Skills panel tracks professions.", "Training one path never closes another. You may learn every weapon discipline and every profession on the same character."])
label_override = "Explain character progression"
metadata/_custom_type_script = "uid://cb4eeew5u1da1"

[sub_resource type="Resource" id="Dialogue_combat"]
script = ExtResource("5_dialogue")
lines = Array[String](["Defeating enemies grants character experience. The weapon category you wield also gains its own Mastery experience from the victory.", "Mastery levels grant points for that discipline's abilities and passive improvements. Open the Mastery panel to review them and manage your equipped abilities.", "You are not choosing a permanent class. Change weapons whenever you like and train every combat discipline over time."])
label_override = "How do combat and Mastery work?"
metadata/_custom_type_script = "uid://cb4eeew5u1da1"

[sub_resource type="Resource" id="Dialogue_professions"]
script = ExtResource("5_dialogue")
lines = Array[String](["Mining, Harvesting, and Woodcutting are gathering professions. Interacting with suitable resource nodes grants materials and experience for the profession tied to that resource.", "Smithing and Outfitting are crafting professions. Use the appropriate crafting station and complete recipes to earn experience in that profession.", "Each profession has its own level and progression. You can train all of them, and the Skills panel shows their current levels.", "Some resources and recipes require higher profession levels. Start with the lowest-level sources available, keep the materials you gather, and use them in matching recipes. Trees and ore veins sit in the castle gathering yard."])
label_override = "How do I train professions?"
metadata/_custom_type_script = "uid://cb4eeew5u1da1"

[sub_resource type="Resource" id="Dialogue_first_steps"]
script = ExtResource("5_dialogue")
lines = Array[String](["Begin with Find Your Footing in my Quests list. It is an orientation assignment, not a choice of class or profession.", "Track it from your Quests panel, then take the main exit into the overworld. You will be free to pursue combat, gathering, crafting, or any mixture of them.", "The Daily Quest Board offers optional rotating work. It is extra progression, never a permanent path decision."])
label_override = "What should I do first?"
metadata/_custom_type_script = "uid://cb4eeew5u1da1"

[sub_resource type="Resource" id="Dialogue_keeper"]
script = ExtResource("5_dialogue")
lines = Array[String](["I kept a gate once. Then a wall. Now I keep this hall and make certain new Heroes leave it knowing where their feet are pointed.", "The Charter records what you owe. I concern myself with what you can become after you walk through that door."])
label_override = "Tell me about yourself"
metadata/_custom_type_script = "uid://cb4eeew5u1da1"

[resource]
script = ExtResource("7_npc")
npc_name = "Hall Keeper"
skin = ExtResource("6_skin")
greeting = "Registration complete? Good. Before you leave this hall, remember one thing: Arkenelle does not lock you into a class, weapon, or profession. Every Hero may train every path. I can explain the systems, then give you your first assignment."
interactions = Array[ExtResource("1_interaction")]([SubResource("QuestInteraction_welcome"), SubResource("Dialogue_progression"), SubResource("Dialogue_combat"), SubResource("Dialogue_professions"), SubResource("Dialogue_first_steps"), SubResource("Dialogue_keeper")])
metadata/_custom_type_script = "uid://ddps5vwhnf048"
