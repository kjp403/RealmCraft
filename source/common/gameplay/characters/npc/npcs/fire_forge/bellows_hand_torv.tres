[sub_resource type="Resource" id="Dialogue_torv"]
script = ExtResource("4_dialogue")
lines = Array[String](["Forty years on the bellows. My hearing is gone and my arms are excellent.", "Helka says hold the halls. I say hold the bridges. Bridges are where they have to come to you.", "You want the west hall first. East hall has the templars and they do not tire."])
label_override = "Ask where to start"

[sub_resource type="Resource" id="Dialogue_down"]
script = ExtResource("4_dialogue")
lines = Array[String](["The stair down goes past where the masonry stops. After that it is just the mountain.", "There is a lake down there that is not water. Something walks its shore."])
label_override = "Ask about the descent"

[resource]
script = ExtResource("1_npcres")
npc_name = "Bellows Hand Torv"
skin = ExtResource("6_skin")
greeting = "Speak up. Forty years of bellows and I hear about half of what anyone says to me."
interactions = Array[ExtResource("2_npcint")]([SubResource("Dialogue_torv"), SubResource("Dialogue_down")])
