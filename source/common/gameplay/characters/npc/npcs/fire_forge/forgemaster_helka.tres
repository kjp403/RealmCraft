[sub_resource type="Resource" id="Dialogue_helka"]
script = ExtResource("4_dialogue")
lines = Array[String](["Two halls, four bridges, six quench wells. I know this floor better than my own hands.", "The crews that hold it now are not mine. They wear our marks and they do not answer to them.", "Stay on the walkways. What is under the grates is still hot."])
label_override = "Ask about the gallery"

[resource]
script = ExtResource("1_npcres")
npc_name = "Forgemaster Helka"
skin = ExtResource("6_skin")
greeting = "Mind the heat and mind your manners. This is still a working floor, whatever has moved into it."
interactions = Array[ExtResource("2_npcint")]([SubResource("Shop_helka"), SubResource("QuestInteraction_helka"), SubResource("Dialogue_helka")])
