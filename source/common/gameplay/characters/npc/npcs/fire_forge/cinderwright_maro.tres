[sub_resource type="Resource" id="Dialogue_maro"]
script = ExtResource("4_dialogue")
lines = Array[String](["The ledges spiral. Every turn takes you one step closer to the lake and one step warmer.", "Do not try to cut across. The lake does not care how fast you are.", "Count the torches. I set one on every ledge. When you run out of torches you are at the shore."])
label_override = "Ask about the descent"

[sub_resource type="Resource" id="Dialogue_vurthek"]
script = ExtResource("4_dialogue")
lines = Array[String](["Vurthek was here before the foundry. The foundry was built around it and called that a victory.", "It throws a line of fire the length of the shore. When it does, put rock between you and it.", "Below half strength it stops pacing and starts hunting. That is the fight, really."])
label_override = "Ask about the Cinderborn"

[resource]
script = ExtResource("1_npcres")
npc_name = "Cinderwright Maro"
skin = ExtResource("6_skin")
greeting = "You have come a long way down for something that will almost certainly kill you. Let me at least make it interesting."
interactions = Array[ExtResource("2_npcint")]([SubResource("Dialogue_maro"), SubResource("Dialogue_vurthek")])
