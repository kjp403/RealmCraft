destination_label = "Fire Forge"
label_override = "Travel to the Fire Forge"
metadata/_custom_type_script = "uid://tymg4stz49lmb"

[resource]
script = ExtResource("5_npc")
npc_name = "Forge Golem"
skin = ExtResource("6_skin")
greeting = "Molten paths. I open them. Speak if you seek the Fire Forge."
interactions = Array[ExtResource("1_i")]([SubResource("Resource_dial"), SubResource("Resource_warp")])
metadata/_custom_type_script = "uid://ddps5vwhnf048"
