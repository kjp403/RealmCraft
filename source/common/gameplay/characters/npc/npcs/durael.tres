[sub_resource type="Resource" id="Dialogue_durael_points"]
script = ExtResource("4_dialogue")
lines = Array[String](["Finish what I give you and I pay in Slayer points, not gold — spend them once the reward stock is worth spending on. Keep a streak going and every tenth completion pays out heavier.", "Change your mind mid-task and it will cost you points, not your streak. Only Turael's free hand resets that count — mine doesn't."])
label_override = "How do your rewards work?"
metadata/_custom_type_script = "uid://cb4eeew5u1da1"

[resource]
script = ExtResource("6_npc")
npc_name = "Durael"
skin = ExtResource("5_skin")
greeting = "You've outgrown Turael's list. I keep sharper company on mine — orcs, golems, things with real teeth. Complete what I give you and I'll see you're paid for it."
interactions = Array[ExtResource("1_interaction")]([SubResource("SlayerInteraction_durael"), SubResource("Dialogue_durael_points")])
metadata/_custom_type_script = "uid://ddps5vwhnf048"
