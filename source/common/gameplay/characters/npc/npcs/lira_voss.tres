[sub_resource type="Resource" id="Dialogue_roots"]
script = ExtResource("2_dialogue")
lines = Array[String](["Do not pull. The roots go through the wall and through me. Cutting them cuts me.", "Calder sent you? Then he lived. Tell him I am still here.", "There is a scribe deeper in. Wren. She has been watching the glow like it owes her money."])
label_override = "How are you stuck?"

[resource]
script = ExtResource("6_npc")
npc_name = "Lira Voss"
skin = ExtResource("5_skin")
greeting = "Don't — don't touch the roots. They drink. Calder's partner. Still here. Mostly."
interactions = Array[ExtResource("1_interaction")]([SubResource("QuestInteraction_lira"), SubResource("Dialogue_roots")])
