[sub_resource type="Resource" id="ShopInteraction_angler"]
script = ExtResource("3_shop")
shop = ExtResource("5_shop")

[sub_resource type="Resource" id="Dialogue_tide"]
script = ExtResource("4_dialogue")
lines = Array[String](["Past sixty, the shallows have nothing left to teach you. I run a boat out to the Deep Shoals — halibut, ray, wolffish, and the blue ones if you're lucky.", "Tide's fair. Rods for every angler — starter through seasoned.", "Better gear means fewer wasted casts. The fish still decide, though.", "Deep Cove keeps the bigger bites. Bring a stronger rod if you go."])
label_override = "Ask about fishing"

[sub_resource type="Resource" id="Warp_shoals"]
script = ExtResource("7_warp")
target_instance = ExtResource("8_shoals")
target_id = 0
destination_label = "The Deep Shoals"
required_skill = &"fishing"
required_skill_level = 60

[resource]
script = ExtResource("1_npcres")
npc_name = "Beach Angler"
skin = ExtResource("6_skin")
greeting = "Need a rod? I've got four tiers — from first cast to faster reels."
interactions = Array[ExtResource("2_npcint")]([SubResource("ShopInteraction_angler"), SubResource("Warp_shoals"), SubResource("Dialogue_tide")])
