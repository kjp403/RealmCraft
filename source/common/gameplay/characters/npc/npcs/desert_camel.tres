[sub_resource type="Resource" id="Resource_dial"]
script = ExtResource("2_d")
lines = Array[String](["I've crossed those dunes more times than I've shed fur. Heat, tombs, and sand that bites.", "Recommended around levels 25–30. Pack water. Pack patience."])
