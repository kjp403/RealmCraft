[sub_resource type="Resource" id="Dialogue_terraces"]
script = ExtResource("4_dialogue")
lines = Array[String](["We stopped climbing when the wind started taking the mules. So: we trade up here now.", "The spire in the middle was a watchtower once. Whoever watched from it is not telling.", "Walk the ring, not across it. Across it is where the harpies nest."])
label_override = "Ask about the terraces"

[resource]
script = ExtResource("1_npcres")
npc_name = "Caravan Master Sefu"
skin = ExtResource("6_skin")
greeting = "You came up the stair? Then you have legs and no sense. Good — both sell well here."
interactions = Array[ExtResource("2_npcint")]([SubResource("Shop_sefu"), SubResource("Dialogue_terraces")])
