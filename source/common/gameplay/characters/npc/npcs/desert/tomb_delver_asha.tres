[sub_resource type="Resource" id="Dialogue_asha"]
script = ExtResource("4_dialogue")
lines = Array[String](["I have opened nine coffins and gone home rich from two. The maths is worse than it sounds.", "The alcoves are the safe part. The long hall north is the whole problem.", "He is at the end of it. Crowned, armoured, and extremely awake."])
label_override = "Ask what is down here"

[sub_resource type="Resource" id="Dialogue_king"]
script = ExtResource("4_dialogue")
lines = Array[String](["Ankhemet. They buried him with his guard still breathing, which tells you the mood at the funeral.", "When his health breaks he calls the hall up around him. Do not fight him in the open floor.", "If you kill him, leave the crown. Please. I am asking nicely."])
label_override = "Ask about the Sand King"

[resource]
script = ExtResource("1_npcres")
npc_name = "Tomb Delver Asha"
skin = ExtResource("6_skin")
greeting = "Another one down the stair. Sit a moment — I would rather you learned this from me than from him."
interactions = Array[ExtResource("2_npcint")]([SubResource("QuestInteraction_asha"), SubResource("Dialogue_asha"), SubResource("Dialogue_king")])
