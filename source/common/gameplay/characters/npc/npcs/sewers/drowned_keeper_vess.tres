[sub_resource type="Resource" id="QuestInteraction_vess"]
script = ExtResource("7_quest")
quests = Array[ExtResource("8_questres")]([ExtResource("9_q1")])

[sub_resource type="Resource" id="Dialogue_vess"]
script = ExtResource("4_dialogue")
lines = Array[String](["This was a reservoir before it was a grave. The mosaic on the floor was meant to be admired from a balcony.", "The balcony is gone. The mosaic is not. Neither is what stands on it.", "Wade the shallows if you must — they only come up to the knee. It is what wades with you."])
label_override = "Ask about the reservoir"

[sub_resource type="Resource" id="Dialogue_sovereign"]
script = ExtResource("4_dialogue")
lines = Array[String](["It has no name that anyone wrote down, so the crews called it the Sovereign and stopped coming.", "It splits when it is hurt. Kill the small ones fast or you will be fighting a crowd."])
label_override = "Ask about the Sovereign"

[resource]
script = ExtResource("1_npcres")
npc_name = "Drowned Keeper Vess"
skin = ExtResource("6_skin")
greeting = "Quietly, now. Sound carries strangely over standing water, and it is listening."
interactions = Array[ExtResource("2_npcint")]([SubResource("QuestInteraction_vess"), SubResource("Dialogue_vess"), SubResource("Dialogue_sovereign")])
