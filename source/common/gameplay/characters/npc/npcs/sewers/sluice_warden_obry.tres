[sub_resource type="Resource" id="Dialogue_obry"]
script = ExtResource("4_dialogue")
lines = Array[String](["City above, culverts below, and me in the middle keeping the grates shut. Mostly shut.", "Sewer skeletons patrol north of this grate. One of them still has a sealed crate.", "Anything that comes up through a grate is my problem. Anything that goes down is yours."])
label_override = "Ask about the works"

[resource]
script = ExtResource("1_npcres")
npc_name = "Sluice Warden Obry"
skin = ExtResource("6_skin")
greeting = "Mind the grates. I have lost two lanterns and one apprentice to them this season."
interactions = Array[ExtResource("2_npcint")]([SubResource("Shop_obry"), SubResource("QuestInteraction_obry"), SubResource("Dialogue_obry")])
