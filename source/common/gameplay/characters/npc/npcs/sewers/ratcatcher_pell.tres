[sub_resource type="Resource" id="Dialogue_pell"]
script = ExtResource("4_dialogue")
lines = Array[String](["Rats I can handle. It is the things that have started eating the rats that worry me.", "Four ways out of every junction. Learn them or the oozes will learn you.", "The green lamps are mine. Where they stop, I stopped too."])
label_override = "Ask about the junctions"

[sub_resource type="Resource" id="Dialogue_deep"]
script = ExtResource("4_dialogue")
lines = Array[String](["Back in The Sewers, take the east stair — The Drowned Cistern. Vess is on the landing.", "The thing itself is not down there. Vess will tell you where."])
label_override = "Ask what is below"

[resource]
script = ExtResource("1_npcres")
npc_name = "Ratcatcher Pell"
skin = ExtResource("6_skin")
greeting = "Careful where you put your boots. Half of what is on this floor used to be moving."
interactions = Array[ExtResource("2_npcint")]([SubResource("QuestInteraction_pell"), SubResource("Dialogue_pell"), SubResource("Dialogue_deep")])
