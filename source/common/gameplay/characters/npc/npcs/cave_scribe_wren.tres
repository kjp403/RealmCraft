[sub_resource type="Resource" id="Dialogue_seep"]
script = ExtResource("2_dialogue")
lines = Array[String](["This cave used to be a clean dig. Then a seep reached it and the fungus learned to walk.", "The Heart feeds the roots. Pale caps grow at its feet. They look like medicine. Sometimes they are not.", "Maela cuts what she can see. I write what the glow does when no one is looking."])
label_override = "Ask about the seep"

[resource]
script = ExtResource("6_npc")
npc_name = "Wren"
skin = ExtResource("5_skin")
greeting = "Keep your voice down. The glow listens. You are here for Lira? Then we brew, and we hope the first bottle is the true one."
interactions = Array[ExtResource("1_interaction")]([SubResource("QuestInteraction_wren"), SubResource("Dialogue_seep")])
