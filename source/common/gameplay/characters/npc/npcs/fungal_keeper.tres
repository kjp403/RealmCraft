[sub_resource type="Resource" id="Resource_dial"]
script = ExtResource("4_dial")
lines = Array[String](["The Domain is a sealed pocket past the seep. Rooms lock behind you until the spawn is dead.", "Three rewarded clears a day per character. Solo pays better — double drop chances, half-again the haul. Groups share the danger, not the bonus.", "Bosses elsewhere drop Dungeon Keys. Use one when you're out of charges. Failed runs don't spend a charge."])
label_override = "How does this work?"
metadata/_custom_type_script = "uid://cb4eeew5u1da1"

