[gd_resource type="Resource" script_class="NPCResource" format=3 uid="uid://df8ykjq6jvwb7"]

[ext_resource type="Script" uid="uid://bg3vv3lo3vxog" path="res://source/common/gameplay/characters/npc/interactions/npc_interaction.gd" id="1_interaction"]
[ext_resource type="Script" uid="uid://cb4eeew5u1da1" path="res://source/common/gameplay/characters/npc/interactions/dialogue_interaction.gd" id="2_dialogue"]
[ext_resource type="Script" uid="uid://ddps5vwhnf048" path="res://source/common/gameplay/characters/npc/npc_resource.gd" id="3_npc"]

[sub_resource type="Resource" id="Dialogue_register"]
script = ExtResource("2_dialogue")
lines = Array[String](["Let me see... name entered, Charter seal applied. You are now registered as a Hero of the Realm.", "Your starter allowance contains 25 gold and one health potion. It has been placed in your inventory.", "The allowance is issued once, so spend it carefully. You will earn more gold by completing quests, defeating enemies, gathering resources, and trading."])
label_override = "Complete my registration"
metadata/_custom_type_script = "uid://cb4eeew5u1da1"

[sub_resource type="Resource" id="Dialogue_menus"]
script = ExtResource("2_dialogue")
lines = Array[String](["Use the bag button on your bottom menu bar to open your Inventory. It holds your items, materials, consumables, and gold.", "Use the equipment button to view everything you are wearing. Items normally begin in your inventory before you equip them.", "Use the quest button to view your active and completed quests. An active quest shows its objectives and what you need to do next.", "These menus can be opened and closed with the same buttons, so they will not permanently cover your view."])
label_override = "Explain my Inventory, Equipment, and Quests"
metadata/_custom_type_script = "uid://cb4eeew5u1da1"

[sub_resource type="Resource" id="Dialogue_next"]
script = ExtResource("2_dialogue")
lines = Array[String](["Your registration is complete. Take the exit from this room and speak with the Hall Keeper in the chamber beyond.", "The Hall Keeper will explain how progression works and introduce you to the activities available throughout the Realm.", "You will also see a Daily Quest Board nearby. Leave that alone until the Hall Keeper has finished your introduction."])
label_override = "What should I do next?"
metadata/_custom_type_script = "uid://cb4eeew5u1da1"

[resource]
script = ExtResource("3_npc")
npc_name = "Charter Clerk"
greeting = "Approach the desk. Every new arrival must be entered into the Charter before leaving the Intake."
interactions = Array[ExtResource("1_interaction")]([SubResource("Dialogue_register"), SubResource("Dialogue_menus"), SubResource("Dialogue_next")])
metadata/_custom_type_script = "uid://ddps5vwhnf048"
