[sub_resource type="Resource" id="QuestInteraction_clerk"]
script = ExtResource("4_quest")
quests = Array[ExtResource("5_questres")]([ExtResource("6_seal")])

[sub_resource type="Resource" id="Dialogue_register"]
script = ExtResource("2_dialogue")
lines = Array[String](["Let me see... name entered, Charter seal applied. You are now registered as a Hero of the Realm.", "Your allowance is in your inventory: one thousand gold, five Health Potions and five Minor Health Potions.", "With them, one of every wooden weapon — sword, hammer, bow, wand and book — and one of every wooden tool: axe, pickaxe, sickle and fishing rod.", "The Charter does not assign you a weapon. It issues all five so the choice is yours and you can change it later. Each one trains its own Mastery, and the tools open the professions.", "The thousand gold is issued once. It is meant to cover your first repairs and supplies, not to make you rich. Quests, kills, gathering and trade earn the rest."])
label_override = "Complete my registration"
metadata/_custom_type_script = "uid://cb4eeew5u1da1"

[sub_resource type="Resource" id="Tutorial_menus"]
script = ExtResource("7_tutorial")
topic = &"menus"
label_override = "Show me my Inventory, Equipment and Quests"

[sub_resource type="Resource" id="Tutorial_mastery"]
script = ExtResource("7_tutorial")
topic = &"mastery"
label_override = "Explain Weapon Mastery"

[sub_resource type="Resource" id="Dialogue_next"]
script = ExtResource("2_dialogue")
lines = Array[String](["Your registration is complete. Take the exit from this room and speak with the Hall Keeper in the chamber beyond.", "The Hall Keeper will explain how progression works and introduce you to the activities available throughout the Realm.", "You will also see a Daily Quest Board nearby. Leave that alone until the Hall Keeper has finished your introduction."])
label_override = "What should I do next?"
metadata/_custom_type_script = "uid://cb4eeew5u1da1"

[resource]
script = ExtResource("3_npc")
npc_name = "Charter Clerk"
location_hint = "Castle Garden, Intake"
greeting = "Approach the desk. Every new arrival must be entered into the Charter before leaving the Intake."
interactions = Array[ExtResource("1_interaction")]([SubResource("QuestInteraction_clerk"), SubResource("Dialogue_register"), SubResource("Tutorial_menus"), SubResource("Tutorial_mastery"), SubResource("Dialogue_next")])
metadata/_custom_type_script = "uid://ddps5vwhnf048"
