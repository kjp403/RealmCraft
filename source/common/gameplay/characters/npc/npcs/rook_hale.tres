quests = Array[ExtResource("4_questres")]([ExtResource("7_q1"), ExtResource("8_q2")])

[sub_resource type="Resource" id="Dialogue_cage"]
script = ExtResource("2_dialogue")
lines = Array[String](["They took me because I saw the crates. Vein-ore that hums. They run it through the city grates.", "The Captain keeps the key. The Watch cannot come in. You can.", "If Lira is alive, tell her I still have both hands. For now."])
label_override = "Why did they take you?"

[sub_resource type="Resource" id="QuestBoss_fight"]
script = ExtResource("qboss")
enemy_type = &"bandit_captain"

[resource]
script = ExtResource("6_npc")
npc_name = "Rook Hale"
location_hint = "Bandit Hideout"
skin = ExtResource("5_skin")
greeting = "Hero. Do not look like you are rescuing me until the Captain is down. They will cut a throat for less."
interactions = Array[ExtResource("1_interaction")]([SubResource("QuestInteraction_rook"), SubResource("Dialogue_cage"), SubResource("QuestBoss_fight")])
