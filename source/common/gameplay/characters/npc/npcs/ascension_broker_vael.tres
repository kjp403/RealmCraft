[sub_resource type="Resource" id="Shop_ascension"]
script = ExtResource("3_shop")
shop = ExtResource("5_shop")
label_override = "Browse Ascension wares"

[sub_resource type="Resource" id="Talk_ascension"]
script = ExtResource("4_diag")
lines = Array[String](["Mastery past Dragon is no longer a rumor. Basilisk to Worldbreaker — the ladder is real.", "I sell the ores, leathers, cloths, and gems the anvil and workbench demand. Arms and armor you forge yourself.", "Jewelry of the new covenants sits on that shelf. Rings for the road. Relics for the vow.", "Hard clears and rare drops still beat my prices. I am the patient path."])
label_override = "Ask about Ascension"

[resource]
script = ExtResource("1_npc")
npc_name = "Ascension Broker Vael"
skin = ExtResource("6_skin")
greeting = "Past Dragon, Sirenic, Ancient — the next climb has names. I keep the materials. You keep the scars."
interactions = Array[ExtResource("2_inter")]([SubResource("Shop_ascension"), SubResource("Talk_ascension")])
