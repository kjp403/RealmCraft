[sub_resource type="Resource" id="Menu_mailbox"]
script = ExtResource("2_menu")
menu = &"mail"
label_override = "Open Mailbox"

[sub_resource type="Resource" id="Dialogue_mail"]
script = ExtResource("3_dialogue")
lines = Array[String](["Every market payout comes through me. Sell something and the gold waits here; buy something and the goods do.", "Nothing in the mailbox expires or goes astray, so claim it whenever you have a free bag slot.", "You can open the same mailbox anywhere from the menu panel — I am only here to save you the trip."])
label_override = "What is the mailbox for?"

[resource]
script = ExtResource("5_npc")
npc_name = "Mail Clerk"
location_hint = "Guild Hall, the upper gallery"
skin = ExtResource("4_skin")
greeting = "Post for you? Sales, purchases and returns all land in your mailbox."
interactions = Array[ExtResource("1_interaction")]([SubResource("Menu_mailbox"), SubResource("Dialogue_mail")])
