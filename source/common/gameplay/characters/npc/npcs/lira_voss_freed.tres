[sub_resource type="Resource" id="Dialogue_free"]
script = ExtResource("2_dialogue")
lines = Array[String](["The roots let go. I can walk. I will not forget the smell.", "Rook was with us when the Chief drove us through. Bandits took him toward their camp while I was being eaten.", "Calder is still at the hole. Tell him I am out when you can. After Rook."])
label_override = "What now?"

[resource]
script = ExtResource("6_npc")
npc_name = "Lira Voss"
skin = ExtResource("5_skin")
greeting = "I am out. The cave still wants me. Rook does not have that luxury — the bandits dragged him."
interactions = Array[ExtResource("1_interaction")]([SubResource("QuestInteraction_lira_freed"), SubResource("Dialogue_free")])
