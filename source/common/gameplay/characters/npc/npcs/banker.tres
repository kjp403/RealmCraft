[sub_resource type="Resource" id="Dialogue_banker"]
script = ExtResource("3_dialogue")
lines = Array[String](["I keep every Hero's vault. Deposit what you cannot carry; withdraw whenever you return.", "There is no limit to what you may store. Stacks stay intact, and your bag stays free for the road."])
label_override = "How does the bank work?"
