[resource]
script = ExtResource("1_jp")
icon = ExtResource("icon_tex")
job_slug = &"prayer"
display_name = "Prayer"
category = &"combat"
sort_order = 11
perk_every_levels = 15
perks = Array[Dictionary]([{
"effect": "xp",
"id": "devout",
"max_rank": 3,
"name": "Devout",
"per_rank": 0.05
}, {
"effect": "prayer_drain",
"id": "conservation",
"max_rank": 3,
"name": "Conservation",
"per_rank": 0.05
}])
source_items = Array[ExtResource("1_item")]([ExtResource("s0"), ExtResource("s1"), ExtResource("s2")])
