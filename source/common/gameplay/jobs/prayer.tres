[ext_resource type="Texture2D" path="res://assets/sprites/ui/menu_icons_shadow/32px/realmcraft_menu_icons/Prayer.png" id="icon_tex"]
[ext_resource type="Script" path="res://source/common/gameplay/items/item.gd" id="1_item"]
