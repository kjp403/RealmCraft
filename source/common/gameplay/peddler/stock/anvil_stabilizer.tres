[resource]
script = ExtResource("1_script")
id = "anvil_stabilizer"
item_name = "Anvil Stabilizer"
description = "A weighted collar that holds a furnace on heat and an anvil true. Ten minutes of steady iron: bars pour twice as fast, and hammered work keeps pace."
effect = "Smelting and smithing run at double speed for 10 minutes — the furnace and the anvil both. Using a second stabilizer adds another 10 minutes rather than restarting the clock."
