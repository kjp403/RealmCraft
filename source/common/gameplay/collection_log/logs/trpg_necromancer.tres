[gd_resource type="Resource" script_class="BossCollectionLog" format=3]

; Necromancer — Seven entries: the Duskfeather Cloak (1/667) is exclusive to this boss.
;
; Built entirely from existing drops: the boss's exclusive relic plus the weapon
; family off its own table. No new items, so nothing here needs balancing against
; the endgame ceiling.

[ext_resource type="Script" path="res://source/common/gameplay/collection_log/boss_collection_log.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://source/common/gameplay/collection_log/vfx/green_log_fx_unquiet_hour.tscn" id="2_vfx"]

[resource]
script = ExtResource("1_script")
boss_id = &"trpg_necromancer"
boss_name = "Necromancer"
log_items = Array[StringName]([&"relic_netherglass", &"duskfeather_cloak", &"sword_wyrmguard.item", &"hammer_wyrmguard.item", &"nightglass_bow.item", &"wand_astral.item", &"book_astral.item"])
green_log_title_text = "Nethersworn"
green_log_vfx = ExtResource("2_vfx")
green_log_profile = &"nethersworn"
green_log_title_style = 3
green_log_title_color = Color(0.58823529, 0.36078431, 0.88627451, 1)
