[gd_resource type="Resource" script_class="BossCollectionLog" format=3]

; Bandit Warlord — Fifth weapon is wand_bandit, NOT wand_rustic — the family is not uniform.
;
; Built entirely from existing drops: the boss's exclusive relic plus the weapon
; family off its own table. No new items, so nothing here needs balancing against
; the endgame ceiling.

[ext_resource type="Script" path="res://source/common/gameplay/collection_log/boss_collection_log.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://source/common/gameplay/collection_log/vfx/green_log_fx_long_road.tscn" id="2_vfx"]

[resource]
script = ExtResource("1_script")
boss_id = &"bandit_captain"
boss_name = "Bandit Warlord"
log_items = Array[StringName]([&"relic_bloodbrand", &"sword_rustic.item", &"hammer_rustic.item", &"book_rustic.item", &"rustic_bow.item", &"wand_bandit.item"])
green_log_title_text = "Toll of the Long Road"
green_log_vfx = ExtResource("2_vfx")
green_log_title_style = 6
green_log_title_color = Color(0.80, 0.62, 0.42, 1)
