[gd_resource type="Resource" script_class="BossCollectionLog" format=3]

; Mecha-stone Golem — Mixed family: Basilisk melee, Runewoven casters, a Wraithsilk bow.
;
; Built entirely from existing drops: the boss's exclusive relic plus the weapon
; family off its own table. No new items, so nothing here needs balancing against
; the endgame ceiling.

[ext_resource type="Script" path="res://source/common/gameplay/collection_log/boss_collection_log.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://source/common/gameplay/collection_log/vfx/green_log_fx_stone_remembered.tscn" id="2_vfx"]

[resource]
script = ExtResource("1_script")
boss_id = &"mecha_stone_golem"
boss_name = "Mecha-stone Golem"
log_items = Array[StringName]([&"relic_coreblossom", &"sword_basilisk.item", &"hammer_basilisk.item", &"wand_runewoven.item", &"book_runewoven.item", &"wraithsilk_bow.item"])
green_log_title_text = "Golembreaker"
green_log_vfx = ExtResource("2_vfx")
green_log_profile = &"golembreaker"
green_log_title_style = 0
green_log_title_color = Color(0.37647059, 0.83921569, 0.88627451, 1)
