[gd_resource type="Resource" script_class="BossCollectionLog" format=3]

; Goblin Warlord — Moss over old bone. The relic is the chase; the Bone weapons are the income.
;
; Built entirely from existing drops: the boss's exclusive relic plus the weapon
; family off its own table. No new items, so nothing here needs balancing against
; the endgame ceiling.

[ext_resource type="Script" path="res://source/common/gameplay/collection_log/boss_collection_log.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://source/common/gameplay/collection_log/vfx/green_log_fx_moss_crown.tscn" id="2_vfx"]

[resource]
script = ExtResource("1_script")
boss_id = &"goblin_chief"
boss_name = "Goblin Warlord"
log_items = Array[StringName]([&"relic_mossgrown", &"sword_bone.item", &"hammer_bone.item", &"wand_bone.item", &"book_bone.item", &"bone_bow.item"])
green_log_title_text = "Goblinsbane"
green_log_vfx = ExtResource("2_vfx")
green_log_profile = &"goblinsbane"
green_log_title_style = 6
green_log_title_color = Color(0.69803922, 0.30588235, 0.20392157, 1)
