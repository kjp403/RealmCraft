[resource]
script = ExtResource("1_task")
display_name = "The Undead Legion"
enemy_types = Array[StringName]([&"trpg_skeleton", &"trpg_skeleton_archer", &"trpg_armored_skeleton", &"trpg_greatsword_skeleton", &"trpg_zombie_giant", &"trpg_necromancer"])
min_slayer_level = 60
