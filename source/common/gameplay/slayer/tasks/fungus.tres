[resource]
script = ExtResource("1_task")
display_name = "Fungal Creatures"
enemy_types = Array[StringName]([&"sporeling", &"puffcap", &"spore_swarm", &"myconid_brute", &"spore_tick", &"fungal_heart"])
min_slayer_level = 5
