[resource]
script = ExtResource("2_quest")
quest_name = "Proof of the Hammer"
description = "You already have a real weapon from the Chief. Armor is the anvil's job. Mine copper and tin in the castle yard, smelt a bronze bar, and forge one bronze armour piece — helm, chest, or boots. Keep it. Then go through the hole and find Lira."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_helm"), SubResource("Obj_chest"), SubResource("Obj_boots")])
completion = 1
unlock_message = "[Scout Calder] Bone cuts. Bronze wears. Forge a piece of plate at the anvil and keep it. The hole is worse than goblins."
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
reward_xp = 110
reward_mastery_xp = 8000
reward_gold = 700
metadata/slug = &"proof_of_the_hammer"
metadata/id = 54
