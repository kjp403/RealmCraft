[resource]
script = ExtResource("2_quest")
quest_name = "Proof of the Hammer"
description = "Calder's steel is scrap. Mine copper and tin in the castle yard, smelt a bronze bar, and forge one bronze weapon of your discipline at the anvil. Keep it. Then go through the hole and find Lira."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_sword"), SubResource("Obj_hammer"), SubResource("Obj_bow"), SubResource("Obj_wand"), SubResource("Obj_book")])
completion = 1
unlock_message = "[Scout Calder] That blade is done. Forge bronze in your own style and keep it. The hole is worse than goblins."
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
reward_xp = 110
reward_mastery_xp = 8000
reward_gold = 700
metadata/slug = &"proof_of_the_hammer"
metadata/id = 54
