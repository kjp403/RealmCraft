[sub_resource type="Resource" id="Obj_visit_ilka"]
script = ExtResource("1_obj")
type = 3
target_giver_key = &"dune_scout_ilka"
target_giver_name = "Dune Scout Ilka"
waypoint_labels = PackedStringArray("Desert", "Sunspire Terraces")

[resource]
script = ExtResource("2_quest")
quest_name = "The Builders' Grave"
description = "The Bonecarver names the desert as the builders' grave, and the Hollow as a bound engine that never ran down. In Goblin Woodland, talk to the Desert Camel on the east side and travel to the Desert. Take the west stair into Sunspire Terraces. Dune Scout Ilka is at the landing fire."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_visit_ilka")])
auto_complete = true
min_level = 25
unlock_message = "[Bonecarver] The desert buried the builders. The Hollow never ran down. Ask the Desert Camel in the woodland. In the Desert, take the west stair — Sunspire Terraces. Ilka is at the fire."
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
reward_xp = 140
reward_mastery_xp = 12000
reward_gold = 700
metadata/slug = &"the_builders_grave"
metadata/id = 57
