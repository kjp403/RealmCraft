[gd_resource type="Resource" script_class="QuestResource" format=3]

[ext_resource type="Script" path="res://source/common/gameplay/quests/quest_objective.gd" id="1_obj"]
[ext_resource type="Script" path="res://source/common/gameplay/quests/quest_resource.gd" id="2_quest"]
[ext_resource type="Resource" path="res://source/common/gameplay/quests/resources/hollow_seep/under_the_charter.tres" id="3_prereq"]
[ext_resource type="Resource" path="res://source/common/gameplay/items/quest/sealed_smuggling_crate.tres" id="4_crate"]
[ext_resource type="Script" path="res://source/common/gameplay/quests/quest_reward.gd" id="5_crcb0"]

[sub_resource type="Resource" id="Obj_kill_skeletons"]
script = ExtResource("1_obj")
enemy_type = &"trpg_sewer_skeleton"
required_amount = 8
grant_item = ExtResource("4_crate")
label_override = "Sewer Skeletons"
waypoint_labels = PackedStringArray("The Sewers", "The Gutterworks")

[sub_resource type="Resource" id="Obj_collect_crate"]
script = ExtResource("1_obj")
type = 1
item = ExtResource("4_crate")
label_override = "Sealed Smuggling Crate"

[resource]
script = ExtResource("2_quest")
quest_name = "Grate Cargo"
description = "Sewer skeletons patrol north of Obry's grate on this Gutterworks floor — they respawn. Kill eight; one still carries a Sealed Smuggling Crate. Bring the crate back to Obry. Ratcatcher Pell stands at the same grate when you are done."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_kill_skeletons"), SubResource("Obj_collect_crate")])
min_level = 15
unlock_message = "[Sluice Warden Obry] Crews stopped coming down. Their crates did not. Bring me one that is still sealed."
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
reward_xp = 220
reward_mastery_xp = 40000
reward_gold = 1200
metadata/slug = &"grate_cargo"
metadata/id = 51
