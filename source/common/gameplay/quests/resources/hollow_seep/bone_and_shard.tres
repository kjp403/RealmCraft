[gd_resource type="Resource" script_class="QuestResource" format=3]

[ext_resource type="Script" path="res://source/common/gameplay/quests/quest_objective.gd" id="1_obj"]
[ext_resource type="Script" path="res://source/common/gameplay/quests/quest_resource.gd" id="2_quest"]
[ext_resource type="Resource" path="res://source/common/gameplay/quests/resources/hollow_seep/a_reader_of_wars.tres" id="3_prereq"]
[ext_resource type="Resource" path="res://source/common/gameplay/items/quest/hollow_scarred_bone.tres" id="4_bone"]
[ext_resource type="Script" path="res://source/common/gameplay/quests/quest_reward.gd" id="5_qjqcj"]

[sub_resource type="Resource" id="Obj_kill_bonepickers"]
script = ExtResource("1_obj")
enemy_type = &"bonepicker"
required_amount = 6
grant_item = ExtResource("4_bone")

[sub_resource type="Resource" id="Obj_collect_bone"]
script = ExtResource("1_obj")
type = 1
item = ExtResource("4_bone")
label_override = "Hollow-scarred Bone"

[resource]
script = ExtResource("2_quest")
quest_name = "Bone and Shard"
description = "The Bonecarver will match the shard to Hollow-scarred bone. Kill six bonepickers in DimWood; one carries a marked bone."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_kill_bonepickers"), SubResource("Obj_collect_bone")])
min_level = 20
unlock_message = "[Bonecarver] The shard is a machine-heart's chip. Bring me bone that wears the same vein. Bonepickers keep such things."
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
reward_xp = 280
reward_mastery_xp = 50000
reward_gold = 1500
grants_wardstone = &"forest"
metadata/slug = &"bone_and_shard"
metadata/id = 45
