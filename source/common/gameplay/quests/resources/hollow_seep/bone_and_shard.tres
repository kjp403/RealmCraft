[sub_resource type="Resource" id="Obj_kill_bonepickers"]
script = ExtResource("1_obj")
enemy_type = &"bonepicker"
required_amount = 6
grant_item = ExtResource("4_bone")

[sub_resource type="Resource" id="Obj_collect_bone"]
script = ExtResource("1_obj")
type = 1
item = ExtResource("4_bone")
label_override = "Hollow-scarred Bone"

[sub_resource type="Resource" id="Reward_kit_potion"]
script = ExtResource("kit_reward")
item = ExtResource("kit_pot")
amount = 8

[resource]
script = ExtResource("2_quest")
quest_name = "Bone and Shard"
description = "The Bonecarver will match the shard to Hollow-scarred bone. Kill six bonepickers in the Mining Cave — the portal is in Goblin Woodland. One carries a marked bone. A fairy weapon of your discipline is the next blade after poison."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_kill_bonepickers"), SubResource("Obj_collect_bone")])
min_level = 20
unlock_message = "[Bonecarver] The shard is a machine-heart's chip. Bring me bone that wears the same vein. Bonepickers pick the old mine, not these trees. Portal off Goblin Woodland."
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
reward_xp = 280
reward_mastery_xp = 50000
reward_items = Array[ExtResource("kit_reward")]([SubResource("Reward_kit_potion")])
reward_style_weapons = Array[ExtResource("kit_item")]([ExtResource("kit_w0"), ExtResource("kit_w1"), ExtResource("kit_w2"), ExtResource("kit_w3"), ExtResource("kit_w4")])
reward_gold = 1500
grants_wardstone = &"forest"
metadata/slug = &"bone_and_shard"
metadata/id = 45
