[resource]
script = ExtResource("2_quest")
quest_name = "Rags and Needles"
description = "Calder's cloth is shredded. Goblins drop Forest Cloth. Craft a Cloth Hood, Cloth Vest, and Cloth Shoes at the Smith House workbench. Keep the set — armour is what you make. The bone from the Chief stays in your hand."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_hood"), SubResource("Obj_vest"), SubResource("Obj_shoes")])
unlock_message = "[Scout Calder] I cannot walk in these rags. Craft a full cloth set at the workbench. Keep it. Mine is done."
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
reward_xp = 90
reward_mastery_xp = 5000
reward_gold = 500
metadata/slug = &"rags_and_needles"
metadata/id = 55
