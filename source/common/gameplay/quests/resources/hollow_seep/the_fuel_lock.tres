[sub_resource type="Resource" id="Obj_kill_vurthek"]
script = ExtResource("1_obj")
enemy_type = &"cinderborn"
grant_item = ExtResource("4_seal")

[sub_resource type="Resource" id="Obj_collect_seal"]
script = ExtResource("1_obj")
type = 1
item = ExtResource("4_seal")
label_override = "Quench-Seal"

[sub_resource type="Resource" id="Reward_kit_potion"]
script = ExtResource("kit_reward")
item = ExtResource("kit_pot")
amount = 10

[sub_resource type="Resource" id="Reward_dungeon_key"]
script = ExtResource("kit_reward")
item = ExtResource("dungeon_key")
amount = 2

[resource]
script = ExtResource("2_quest")
quest_name = "The Fuel Lock"
description = "Kill Vurthek the Cinderborn in the Cinder Deeps. Recover the Quench-Seal — the fuel lock — and take it to Helka. A fire weapon of your discipline is the next blade after sunsteel."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_kill_vurthek"), SubResource("Obj_collect_seal")])
min_level = 33
unlock_message = "[Cinderwright Maro] Vurthek was here before the foundry. Take the quench-lock if you live. Helka will know what it means."
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
turn_in_giver_slug = &"forgemaster_helka"
reward_xp = 800
reward_mastery_xp = 140000
reward_items = Array[ExtResource("kit_reward")]([SubResource("Reward_kit_potion"), SubResource("Reward_dungeon_key")])
reward_style_weapons = Array[ExtResource("kit_item")]([ExtResource("kit_w0"), ExtResource("kit_w1"), ExtResource("kit_w2"), ExtResource("kit_w3"), ExtResource("kit_w4")])
reward_gold = 4000
grants_wardstone = &"fire_forge"
metadata/slug = &"the_fuel_lock"
metadata/id = 59
