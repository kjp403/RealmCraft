[sub_resource type="Resource" id="Obj_kill_king"]
script = ExtResource("1_obj")
enemy_type = &"sand_king"
grant_item = ExtResource("4_tablet")
waypoint_labels = PackedStringArray("Desert")

[sub_resource type="Resource" id="Obj_collect_tablet"]
script = ExtResource("1_obj")
type = 1
item = ExtResource("4_tablet")
label_override = "Foundry Tablet"

[sub_resource type="Resource" id="Reward_kit_potion"]
script = ExtResource("kit_reward")
item = ExtResource("kit_pot")
amount = 10

[resource]
script = ExtResource("2_quest")
quest_name = "Leave the Crown"
description = "Kill Ankhemet, the Sand King, north of the Desert grate. Leave the crown. Take the Foundry Tablet that names the last furnace that fed the Hollow — Fire Forge. A sunsteel weapon of your discipline is the next blade after fairy."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_kill_king"), SubResource("Obj_collect_tablet")])
min_level = 28
unlock_message = "[Tomb Delver Asha] He is crowned, armoured, and awake. Leave the crown. Take the tablet if you find one."
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
turn_in_giver_slug = &"tomb_delver_asha"
reward_xp = 650
reward_mastery_xp = 110000
reward_items = Array[ExtResource("kit_reward")]([SubResource("Reward_kit_potion")])
reward_style_weapons = Array[ExtResource("kit_item")]([ExtResource("kit_w0"), ExtResource("kit_w1"), ExtResource("kit_w2"), ExtResource("kit_w3"), ExtResource("kit_w4")])
reward_gold = 3000
grants_wardstone = &"desert"
metadata/slug = &"leave_the_crown"
metadata/id = 52
