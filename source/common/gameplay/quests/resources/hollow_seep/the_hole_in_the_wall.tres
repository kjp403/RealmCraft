[sub_resource type="Resource" id="Obj_visit_calder"]
script = ExtResource("1_obj")
type = 3
target_giver_key = &"scout_calder"
target_giver_name = "Scout Calder"
location_hint = "Goblin Woodland, by the Fungus Cave hole"

[resource]
script = ExtResource("2_quest")
quest_name = "The Hole in the Wall"
description = "The Chief is down and you have bone in hand. A Charter survey is overdue. Find Scout Calder camped by the Hermit's hole in Goblin Woodland — next to the Fungus Cave portal — and hear what the Chief did to his party."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_visit_calder")])
auto_complete = true
unlock_message = "[Hall Keeper] Bone in hand? Good. A scout is down by the hole in the woodland wall. Find Calder. Smithing will make your plate; the hole will make the next blade."
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
reward_xp = 60
reward_mastery_xp = 3000
reward_gold = 300
metadata/slug = &"the_hole_in_the_wall"
metadata/id = 60
