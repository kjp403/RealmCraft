[resource]
script = ExtResource("2_quest")
quest_name = "Hooks and Coals"
description = "Potions run out and nobody sells them cheaply. Food does not run out, because you make it. Your kit already holds a Fishing Rod: take it to the woodland shore, work a shrimp hole until you have raw shrimp, then cook them on the fire by the pier. Five Cooked Shrimp and you never need to buy healing again."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_cook_shrimp")])
auto_complete = true
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
unlock_message = "[Hall Keeper] Your potions are finite. Your fishing rod is not. Woodland shore, shrimp hole, cooking fire — five cooked shrimp and you have a healing supply you own."
reward_xp = 60
reward_gold = 300
