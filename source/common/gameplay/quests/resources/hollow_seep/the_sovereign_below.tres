[ext_resource type="Script" path="res://source/common/gameplay/quests/quest_reward.gd" id="5_0yvqw"]
[ext_resource type="Resource" uid="uid://cdungeonkeyitem1" path="res://source/common/gameplay/items/consumables/dungeon_key.tres" id="dungeon_key"]

[ext_resource type="Script" path="res://source/common/gameplay/quests/quest_reward.gd" id="kit_reward"]
