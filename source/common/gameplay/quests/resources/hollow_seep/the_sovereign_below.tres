[sub_resource type="Resource" id="Obj_kill_sovereign"]
script = ExtResource("1_obj")
enemy_type = &"cistern_sovereign"
label_override = "Defeat The Bloated Sovereign"
grant_item = ExtResource("4_shard")

[sub_resource type="Resource" id="Obj_collect_shard"]
script = ExtResource("1_obj")
type = 1
item = ExtResource("4_shard")
label_override = "Coreblossom Shard"

[sub_resource type="Resource" id="Reward_kit_potion"]
script = ExtResource("kit_reward")
item = ExtResource("kit_pot")
amount = 8

[sub_resource type="Resource" id="Reward_dungeon_key"]
script = ExtResource("kit_reward")
item = ExtResource("dungeon_key")
amount = 2

[resource]
script = ExtResource("2_quest")
quest_name = "The Sovereign Below"
description = "Kill The Bloated Sovereign in the Drowned Cistern. It splits when hurt. Recover the Coreblossom Shard and take it to the Hall Keeper. A poison weapon of your discipline is the next blade after rustic."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_kill_sovereign"), SubResource("Obj_collect_shard")])
min_level = 18
unlock_message = "[Drowned Keeper Vess] It has no name anyone wrote down. Kill it. Bring what it was keeping to the Hall."
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
turn_in_giver_slug = &"hall_keeper"
reward_xp = 500
reward_mastery_xp = 90000
reward_items = Array[ExtResource("kit_reward")]([SubResource("Reward_kit_potion"), SubResource("Reward_dungeon_key")])
reward_style_weapons = Array[ExtResource("kit_item")]([ExtResource("kit_w0"), ExtResource("kit_w1"), ExtResource("kit_w2"), ExtResource("kit_w3"), ExtResource("kit_w4")])
reward_gold = 2500
grants_wardstone = &"sewers"
metadata/slug = &"the_sovereign_below"
metadata/id = 64
