[sub_resource type="Resource" id="Obj_kill_golem"]
script = ExtResource("1_obj")
enemy_type = &"mecha_stone_golem"

[sub_resource type="Resource" id="Reward_kit_potion"]
script = ExtResource("kit_reward")
item = ExtResource("kit_pot")
amount = 12

[sub_resource type="Resource" id="Reward_dungeon_key"]
script = ExtResource("kit_reward")
item = ExtResource("dungeon_key")
amount = 2

[resource]
script = ExtResource("2_quest")
quest_name = "The Thing It Was Built to Run"
description = "As long as the Mecha-stone Golem still runs, the Hollow will drink. Enter The Hollow and kill it. Return to the Hall when the seep is cut. The last Charter blade — basilisk, wraithsilk, or runewoven, matching your discipline — is the reward. Armour after this is still the anvil and later bosses."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_kill_golem")])
min_level = 35
unlock_message = "[Hall Keeper] The last letter. The Hollow was built to run that machine-heart. End it, then come home."
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
reward_xp = 1200
reward_mastery_xp = 200000
reward_items = Array[ExtResource("kit_reward")]([SubResource("Reward_kit_potion"), SubResource("Reward_dungeon_key")])
reward_style_weapons = Array[ExtResource("kit_item")]([ExtResource("kit_w0"), ExtResource("kit_w1"), ExtResource("kit_w2"), ExtResource("kit_w3"), ExtResource("kit_w4")])
reward_gold = 6000
grant_title = "Hollow-Sworn"
grants_wardstone = &"hollow"
metadata/slug = &"the_thing_it_was_built_to_run"
metadata/id = 65
