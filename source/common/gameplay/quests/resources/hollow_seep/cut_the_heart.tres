[resource]
script = ExtResource("2_quest")
quest_name = "Cut the Heart"
description = "The tonic did not take. The Heart is feeding the roots that hold Lira — the pale cap was a decoy. Kill the Fungal Heart. It yields the True Seep Root."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_kill_heart")])
unlock_message = "[Lira Voss] It doesn't take. The Heart is feeding these roots. Cut it. The cap was a lie."
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
reward_xp = 350
reward_mastery_xp = 50000
reward_gold = 2000
grants_wardstone = &"fungus_cave"
