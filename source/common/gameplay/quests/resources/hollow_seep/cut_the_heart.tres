[sub_resource type="Resource" id="Obj_kill_heart"]
script = ExtResource("1_obj")
enemy_type = &"fungal_heart"
grant_item = ExtResource("4_root")

[sub_resource type="Resource" id="Reward_kit_potion"]
script = ExtResource("kit_reward")
item = ExtResource("kit_pot")
amount = 10

[sub_resource type="Resource" id="Reward_dungeon_key"]
script = ExtResource("kit_reward")
item = ExtResource("dungeon_key")

[resource]
script = ExtResource("2_quest")
quest_name = "Cut the Heart"
description = "The tonic did not take. The Heart is feeding the roots that hold Lira — the pale cap was a decoy. Kill the Fungal Heart. It yields the True Seep Root, and Lira will put a spore weapon of your discipline in your hand. That is the next blade after bone."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_kill_heart")])
unlock_message = "[Lira Voss] It doesn't take. The Heart is feeding these roots. Cut it. The cap was a lie."
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
reward_xp = 350
reward_mastery_xp = 50000
reward_items = Array[ExtResource("kit_reward")]([SubResource("Reward_kit_potion"), SubResource("Reward_dungeon_key")])
reward_style_weapons = Array[ExtResource("kit_item")]([ExtResource("kit_w0"), ExtResource("kit_w1"), ExtResource("kit_w2"), ExtResource("kit_w3"), ExtResource("kit_w4")])
reward_gold = 2000
grants_wardstone = &"fungus_cave"
metadata/slug = &"cut_the_heart"
metadata/id = 49
