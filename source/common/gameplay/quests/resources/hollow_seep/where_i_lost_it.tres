[gd_resource type="Resource" script_class="QuestResource" format=3]

[ext_resource type="Script" path="res://source/common/gameplay/quests/quest_objective.gd" id="1_obj"]
[ext_resource type="Script" path="res://source/common/gameplay/quests/quest_resource.gd" id="2_quest"]
[ext_resource type="Resource" path="res://source/common/gameplay/quests/resources/hollow_seep/one_small_favor.tres" id="3_prereq"]
[ext_resource type="Script" path="res://source/common/gameplay/quests/quest_reward.gd" id="5_bgm2s"]
[ext_resource type="Resource" path="res://source/common/gameplay/items/quest/calders_bent_sword.tres" id="5_sword"]

[sub_resource type="Resource" id="Obj_visit_courier"]
script = ExtResource("1_obj")
type = 3
target_giver_key = &"courier"
target_giver_name = "the Courier"
location_hint = "Mining Cave"
grant_item = ExtResource("5_sword")

[sub_resource type="Resource" id="Obj_collect_sword"]
script = ExtResource("1_obj")
type = 1
item = ExtResource("5_sword")
label_override = "Calder's Bent Sword"

[resource]
script = ExtResource("2_quest")
quest_name = "Where I Lost It"
description = "Calder lost his steel in the Mining Cave. Be careful — that is where it happened. Speak with the Courier inside; he found a bent blade near the deep vein. Bring it back."
objectives = Array[ExtResource("1_obj")]([SubResource("Obj_visit_courier"), SubResource("Obj_collect_sword")])
unlock_message = "[Scout Calder] My sword is in the Mining Cave. The Courier runs the vault there. Ask him. Be careful."
requires_quests = Array[ExtResource("2_quest")]([ExtResource("3_prereq")])
reward_xp = 90
reward_mastery_xp = 5000
reward_gold = 500
metadata/slug = &"where_i_lost_it"
metadata/id = 71
