[resource]
script = ExtResource("2_xnv0w")
quest_name = "The Goblin Chief"
description = "The wood kit will not carry you. Kill the Goblin Chief in the warren. Bren will put a bone weapon of your discipline in your hand — that is the upgrade path. Smithing makes armor. Bosses and the Charter spine make the next blade."
objectives = Array[ExtResource("1_8vmji")]([SubResource("Obj_kill_chief")])
min_level = 4
unlock_message = "[Warden Bren] The Chief keeps a bone blade in the warren. That is how Heroes step off wood. Come see me when you are ready."
requires_quests = Array[ExtResource("2_xnv0w")]([ExtResource("3_ivwvu")])
reward_xp = 160
reward_mastery_xp = 20000
reward_gold = 1500
reward_items = Array[ExtResource("4_smysb")]([SubResource("Reward_wood_chest"), SubResource("Reward_kit_potion"), SubResource("Reward_dungeon_key")])
reward_style_weapons = Array[ExtResource("kit_item")]([ExtResource("kit_w0"), ExtResource("kit_w1"), ExtResource("kit_w2"), ExtResource("kit_w3"), ExtResource("kit_w4")])
grant_title = "Warrenbreaker"
grants_wardstone = &"woodland"
metadata/slug = &"the_goblin_chief"
metadata/id = 32
