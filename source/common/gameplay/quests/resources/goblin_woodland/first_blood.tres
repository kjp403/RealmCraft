[resource]
script = ExtResource("2_oa2gf")
quest_name = "First Blood"
description = "The meadow is quieter. Report to Warden Bren at the woodland gate. He wants three more runts as a check, then he will walk you to the warren. The Goblin Chief is not optional — bone from that kill is the first real weapon. Smithing will not match it."
objectives = Array[ExtResource("1_xp0uk")]([SubResource("Obj_kill_runt")])
unlock_message = "[Warden Bren] Twenty runts for the Hall. Three more for me. Then we talk about the Chief and the bone he keeps."
requires_quests = Array[ExtResource("2_oa2gf")]([ExtResource("4_meadow")])
reward_xp = 50
reward_mastery_xp = 2500
reward_gold = 400
